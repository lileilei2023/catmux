{
  "name": "catmux-promo",
  "private": true,
  "description": "Catmux promo videos (Douyin 9:16 + README hero), built with Remotion from real demo-mode screenshots.",
  "scripts": {
    "studio": "remotion studio",
    "render:douyin": "remotion render Douyin out/catmux-douyin.mp4 --codec=h264 --crf=18",
    "render:readme": "remotion render ReadmeHero out/catmux-hero.gif --codec=gif --every-nth-frame=2 --scale=0.75"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/transitions": "4.0.541",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
